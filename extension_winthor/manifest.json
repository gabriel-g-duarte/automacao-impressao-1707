{
  "manifest_version": 3,
  "name": "WinThor Keep AutoSync",
  "version": "12.0",
  "description": "Captura códigos do Google Keep e envia para o servidor local do WinThor",
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://keep.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}